<script is:inline>
  (function () {
    var root = document.documentElement;
    var media = window.matchMedia("(prefers-color-scheme: dark)");
    var apply = function () {
      root.dataset.theme = media.matches ? "dark" : "light";
    };
    root.dataset.accent = "orange";
    apply();
    media.addEventListener("change", apply);
  })();
</script>
